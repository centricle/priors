---
import Base from '../../layouts/Base.astro';
import RunTable from '../../components/RunTable.astro';
import { fmtUsd, isCampaign, loadAll } from '../../lib/data.ts';
import { href } from '../../lib/href.mjs';
import { EFFORTS, sum } from '../../lib/stats.ts';

const { runs, trials } = loadAll();
const campaignRuns = runs.filter((r) => r.mode !== 'pilot').length;
const campaign = trials.filter(isCampaign);
const costCounted = sum(campaign.map((t) => t.cost_usd));
const costAll = sum(trials.map((t) => t.cost_usd));
const fmt = (n: number) => n.toLocaleString('en-US');

// The second campaign: its own runs, its own totals. Nothing is pooled.
const second = loadAll(2);
const secondCost = sum(second.trials.map((t) => t.cost_usd));
const reruns = second.runs.filter((r) => r.rerunOf).length;

// The third campaign: the same four tasks at three effort levels.
const third = loadAll(3);
const thirdCost = sum(third.trials.map((t) => t.cost_usd));
const thirdTasks = [...new Set(third.runs.map((r) => r.task))];
const thirdLevels = EFFORTS.filter((e) => third.runs.some((r) => r.effort === e));
const thirdShort = third.held.length;
// The dek's qualitative words, checked at build time as on /color/.
const check = (ok: boolean, what: string) => {
  if (!ok) throw new Error(`runs: the copy says ${what}, and the data no longer does`);
};
check(third.held.every((h) => h.task === 'circle'), 'every held run is a circle run');
check(third.uncounted.every((a) => a.fallback && a.run.startsWith('circle-')), 'every uncounted attempt is a circle fallback');
check(third.runs.filter((r) => r.effort === 'low').every((r) => r.rerunOf), 'every low run repeats an earlier campaign’s run');
---

<Base
  title="Runs"
  path="/runs/"
  description="Every run in the experiment: one task, one mode, one model, and what it did."
>
  <section class="grid intro">
    <div class="head stack-lg">
      <h1>Runs</h1>
      <p class="dek">
        A run is one task, one mode, one model and n trials. In a sample run every trial starts from
        the same seed. In a chain, each step edits what the step before it left behind. A relay is a
        chain that passes the file between all four models in turn. Everything ran at effort low. All
        but the harness replica and the pilot ran in the stripped room: four tools, no user config.
      </p>
      <p class="totals mono">
        {fmt(campaignRuns)} runs and the pilot · {fmt(trials.length)} trials ({fmt(campaign.length)} counted, {fmt(trials.length - campaign.length)} pilot) · {fmtUsd(costCounted)} API-equivalent counted, {fmtUsd(costAll)} with the pilot
      </p>
    </div>
  </section>
  <section class="grid table-wrap">
    <div class="full">
      <RunTable runs={runs} />
    </div>
  </section>
  <section class="grid intro second" id="color">
    <div class="head stack-lg">
      <h2>The second campaign: color</h2>
      <p class="dek">
        The first campaign watched what the models reached for. This one <a href={href('/color/')}>asks them outright</a>:
        a hex color, a color for a button, a favorite. Same room, same effort, one fresh session per trial. The last
        {reruns} runs are a control: two of the first campaign’s runs again, a week later, for Opus alone.
      </p>
      <p class="totals mono">
        {fmt(second.runs.length)} runs · {fmt(second.trials.length)} trials · {fmtUsd(secondCost)} API-equivalent
      </p>
    </div>
  </section>
  <section class="grid table-wrap">
    <div class="full">
      <RunTable runs={second.runs} />
    </div>
  </section>
  <section class="grid intro second" id="effort">
    <div class="head stack-lg">
      <h2>The third campaign: effort</h2>
      <p class="dek">
        The first two campaigns ran everything at effort low. This one <a href={href('/effort/')}>turns the setting up</a>:
        {thirdTasks.length} of their tasks again, for all four models, at {thirdLevels.join(', ')}. The low runs repeat
        the earlier campaigns’ runs weeks later, as the baseline. {thirdShort} circle runs ended short: a safety
        classifier moved their attempts to another model, and those attempts do not count.
      </p>
      <p class="totals mono">
        {fmt(third.runs.length)} runs · {fmt(third.trials.length)} trials · {fmtUsd(thirdCost)} API-equivalent
      </p>
    </div>
  </section>
  <section class="grid table-wrap">
    <div class="full">
      <RunTable runs={third.runs} held={third.held} effort />
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: calc(var(--row) * 8) calc(var(--row) * 6);
  }
  @media (min-width: 900px) {
    .intro {
      padding-block: calc(var(--row) * 12) calc(var(--row) * 8);
    }
  }
  .intro.second {
    padding-top: calc(var(--row) * 10);
  }
  .intro h2 {
    font-size: var(--t-xl);
  }
  .totals {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }
  .table-wrap {
    padding-bottom: calc(var(--row) * 4);
  }
</style>
