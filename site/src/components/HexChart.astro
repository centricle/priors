---
/**
 * A row of hex colors, each a square whose area is its share of trials.
 *
 * Side = max * sqrt(share), so two squares compare by area the way a bar
 * compares by length. Squares sit on a common baseline; the hex value and the
 * share sit under each, and the two purple stops the models keep reaching for
 * carry a "the prior" tag. Every swatch has a hairline border, or white and
 * near-white colors would vanish into the page. The swatch fill is the data;
 * it is the only color on the chart.
 */
interface Share {
  hex: string;
  count: number;
  share: number;
}
interface Props {
  shares: Share[];
  n: number;
  title?: string;
  size?: 'lg' | 'sm';
}

const { shares, n, title, size = 'lg' } = Astro.props;
const MAX = size === 'lg' ? 120 : 56;
const PRIOR = new Set(['#667eea', '#764ba2']);
const HEX = /^#[0-9a-f]{3,8}$/i;

const side = (s: number) => Math.max(4, Math.round(MAX * Math.sqrt(Math.min(1, Math.max(0, s)))));
const pct = (s: number) => (s > 0 && s < 0.005 ? '<1%' : `${Math.round(s * 100)}%`);
const fill = (hex: string) => (HEX.test(hex) ? hex : 'transparent');
---

<figure class:list={['hex', `is-${size}`]}>
  {title && <figcaption class="cap label">{title}</figcaption>}
  <ul class="swatches" role="list">
    {shares.map((s) => (
      <li class="sw" style={`--side:${side(s.share)}px;--c:${fill(s.hex)}`} title={`${s.hex}: ${s.count} of ${n} trials`}>
        <span class="chip" aria-hidden="true" />
        <span class="hexv">{s.hex}</span>
        <span class="share">{pct(s.share)}</span>
        <span class="slot">{PRIOR.has(s.hex.toLowerCase()) && <mark class="tag">the prior</mark>}</span>
      </li>
    ))}
  </ul>
  <p class="basis">Square area is the share of {n.toLocaleString('en-US')} trials that use the color.</p>
</figure>

<style>
  .hex {
    margin: 0;
  }
  .cap {
    margin-bottom: calc(var(--row) * 1.5);
  }
  .swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: calc(var(--row) * 2) calc(var(--row) * 1.5);
  }
  .sw {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* As wide as its widest part: the square or the label. */
    width: max(var(--side), var(--side-min));
    font-family: var(--mono);
    font-size: var(--t-sm);
    line-height: 1.3;
  }
  .is-lg {
    --side-min: 4.4rem;
  }
  .is-sm {
    --side-min: 3.3rem;
  }
  .is-sm .sw {
    font-size: var(--t-xs);
  }
  .chip {
    display: block;
    width: var(--side);
    height: var(--side);
    background: var(--c);
    border: 1px solid var(--hair);
    margin-bottom: 0.45em;
  }
  .hexv {
    color: var(--ink);
    font-weight: 500;
  }
  .share {
    color: var(--ink-2);
  }
  /* Reserved on every item so labels line up whether or not a tag is present. */
  .slot {
    display: block;
    min-height: 1.7em;
    margin-top: 0.2em;
  }
  .tag {
    display: inline-block;
    font-family: var(--sans);
    font-variation-settings: var(--narrow);
    font-size: var(--t-xs);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    padding: 0.05em 0.35em;
    white-space: nowrap;
  }
  .basis {
    margin: calc(var(--row) * 1.5) 0 0;
    font-size: var(--t-xs);
    color: var(--ink-2);
    font-family: var(--mono);
  }
  .is-sm .basis {
    display: none;
  }
</style>
