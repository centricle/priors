---
/**
 * Every run, grouped by task.
 *
 * One table, one tbody per task, so the columns stay aligned from group to
 * group. Each group brings its own header row because a black-circle run and
 * a pick-a-number run are measured by different things: feature shares for the
 * files the model rewrites, the most common answer for the questions it
 * answers in chat, the one-word rule for the sentence.
 *
 * Within a task: samples in model order, then chains, then the relay chain,
 * then the pilot. A run's first cell links to its page.
 *
 * The table takes one campaign's runs. Reruns of an earlier campaign's runs
 * (the second campaign's control) form their own groups after the rest, so
 * they are not read as part of the campaign's own tasks.
 *
 * With `effort`, a campaign that varies the level (the third): no rerun split,
 * since its low cells are the comparison's baseline, and each model's levels
 * sit together, low to max. `held` adds the runs that ended short; one with no
 * counted trial has no page, so its row is not a link.
 */
import { MODELS, MODEL_LABEL, campaignOrdinal, fmtPct, fmtUsd, isColorTask, promptOf, rerunGap } from '../lib/data.ts';
import type { Held, Model, Run, Task } from '../lib/data.ts';
import { href } from '../lib/href.mjs';
import { EFFORTS, RECOLORED_WHY, answerDistribution, colorLabel, runSummary } from '../lib/stats.ts';
import Swatches from './Swatches.astro';

interface Props {
  runs: Run[];
  held?: Held[];
  effort?: boolean;
}
const { runs, held = [], effort = false } = Astro.props;

const TASK_ORDER: Task[] = [
  'circle', 'html', 'svg', 'sentence', 'number', 'digit', 'word', 'replica',
  'color', 'hex', 'rgb', 'hex2', 'button', 'background', 'gradient', 'favorite', 'best', 'colorize',
];
const kindOf = (t: Task) =>
  t === 'sentence' ? 'sentence' : ['number', 'digit', 'word'].includes(t) || isColorTask(t) ? 'text' : 'artifact';

const modeRank = (r: Run) => (r.mode === 'sample' ? 0 : r.mode === 'chain' ? (r.isRelay ? 2 : 1) : 3);
const modelRank = (r: Run) => (r.isRelay ? MODELS.length : MODELS.indexOf(r.models[0]));
const order = (a: Run, b: Run) =>
  modeRank(a) - modeRank(b) || Number(a.profile === 'harness') - Number(b.profile === 'harness') || modelRank(a) - modelRank(b);
const effortRank = (e: string) => (EFFORTS as readonly string[]).indexOf(e);

// A row is a run, a held run (both, when it counted some trials), or a held
// run alone (none counted).
interface Row {
  run: Run | null;
  held: Held | null;
  model: Model;
  effort: string;
}
const heldOf = (name: string) => held.find((h) => h.name === name) ?? null;
const rowsOf = (rs: Run[], task: Task): Row[] => {
  const own = rs.filter((r) => r.task === task);
  if (!effort) return own.sort(order).map((run) => ({ run, held: heldOf(run.name), model: run.models[0], effort: run.effort }));
  const alone = held.filter((h) => h.task === task && h.counted === 0);
  return [
    ...own.map((run) => ({ run, held: heldOf(run.name), model: run.models[0], effort: run.effort })),
    ...alone.map((h) => ({ run: null, held: h, model: h.model, effort: h.effort })),
  ].sort((a, b) => MODELS.indexOf(a.model) - MODELS.indexOf(b.model) || effortRank(a.effort) - effortRank(b.effort));
};

const groupsOf = (rs: Run[]) =>
  TASK_ORDER.map((task) => ({
    task,
    kind: kindOf(task),
    prompt: promptOf(task),
    rows: rowsOf(rs, task),
  })).filter((g) => g.rows.length > 0);
const groups = effort ? groupsOf(runs) : [...groupsOf(runs.filter((r) => !r.rerunOf)), ...groupsOf(runs.filter((r) => r.rerunOf))];

// Artifact groups are the widest: run, model, n and eight measures. The others span the same width.
const COLS = 11;
const pct = (s: number) => fmtPct(s);
const cls = (s: number) => (s === 0 ? 'num zero' : 'num');
const shorten = (s: string, n: number) => (s.length > n ? s.slice(0, n - 1) + '…' : s);

const linkText = (r: Run) =>
  r.mode === 'pilot' ? 'pilot' : r.profile === 'harness' ? `${r.mode} · harness` : effort ? `${r.mode} · ${r.effort}` : r.mode;
const who = (r: Run) => (r.isRelay ? 'relay' : MODEL_LABEL[r.models[0]]);
const relayTitle = (r: Run) => (r.isRelay ? r.models.map((m) => MODEL_LABEL[m]).join(', ') : undefined);

const rowData = (kind: string, r: Run) => {
  const s = runSummary(r);
  if (kind === 'text') {
    const d = answerDistribution(r.trials);
    return { s, d, top: d.values[0] };
  }
  if (kind === 'sentence') {
    return { s, kept: r.trials.filter((t) => t.answer_ok === true).length, finalWords: r.trials[r.trials.length - 1]?.words ?? null };
  }
  return { s };
};
---

<div class="scroll">
  <table class="runs">
    {groups.map((g) => (
      <tbody>
        <tr class="grp">
          <th colspan={COLS} scope="colgroup">
            <span class="task">{g.task}</span>
            <code class="prompt">{g.prompt}</code>
          </th>
        </tr>
        {g.kind === 'artifact' && (
          <tr class="sub">
            <th scope="col">run</th>
            <th scope="col">model</th>
            <th scope="col" class="num">n</th>
            <th scope="col" class="num" title="Has a shadow, a blur or the word glow">shadow or glow</th>
            <th scope="col" class="num" title="Uses @keyframes">keyframes</th>
            <th scope="col" class="num" title="Contains both #667eea and #764ba2">gradient</th>
            <th scope="col" class="num" title={RECOLORED_WHY}>{colorLabel(g.task)}</th>
            <th scope="col" class="num" title="Contains a script tag">script</th>
            <th scope="col" class="num" title="Left the file exactly as it found it">unchanged</th>
            <th scope="col" class="num" title="Median line count of the output">lines</th>
            <th scope="col" class="num">cost</th>
          </tr>
        )}
        {g.kind === 'text' && (
          <tr class="sub">
            <th scope="col">run</th>
            <th scope="col">model</th>
            <th scope="col" class="num">n</th>
            <th scope="col" colspan="4">top answer</th>
            <th scope="col" class="num">share</th>
            <th scope="col" class="num" title="Replies that were only the value">bare</th>
            <th scope="col" class="num" title="Answers that met the task’s rule">rule met</th>
            <th scope="col" class="num">cost</th>
          </tr>
        )}
        {g.kind === 'sentence' && (
          <tr class="sub">
            <th scope="col">run</th>
            <th scope="col">model</th>
            <th scope="col" class="num">n</th>
            <th scope="col" colspan="6" title="Steps that added exactly one word and removed none">rule kept</th>
            <th scope="col" class="num" title="Words in the sentence after the last step">final words</th>
            <th scope="col" class="num">cost</th>
          </tr>
        )}
        {g.rows.map(({ run: r, held: h, model, effort: level }) => {
          if (!r) {
            return (
              <tr class="held">
                <td>sample · {level}</td>
                <td>{MODEL_LABEL[model]}</td>
                <td class="num">0</td>
                <td colspan={COLS - 3} class="why">{h!.reason}</td>
              </tr>
            );
          }
          const x = rowData(g.kind, r);
          const gap = rerunGap(r);
          return (
            <tr>
              <td>
                <a href={href(`/runs/${r.name}/`)} aria-label={r.label}>{linkText(r)}</a>
                {r.mode === 'pilot' && <div class="note">pilot (scripted loop, contaminated)</div>}
                {gap?.control && (
                  <div class="note">
                    control: <a href={href(`/runs/${gap.of.name}/`)}>the {campaignOrdinal(gap.of.campaign)} campaign’s run</a>, run again
                  </div>
                )}
                {gap && !gap.control && (
                  <div class="note">
                    <a href={href(`/runs/${gap.of.name}/`)}>the {campaignOrdinal(gap.of.campaign)} campaign’s run</a>, {gap.later}
                  </div>
                )}
                {h && <div class="note" title={h.reason}>held at {h.counted} of {h.planned}</div>}
              </td>
              <td title={relayTitle(r)}>{who(r)}</td>
              <td class="num">{r.n}</td>
              {g.kind === 'artifact' && (
                <>
                  <td class={cls(x.s.features.shares.glow_or_shadow.share)}>{pct(x.s.features.shares.glow_or_shadow.share)}</td>
                  <td class={cls(x.s.features.shares.keyframes.share)}>{pct(x.s.features.shares.keyframes.share)}</td>
                  <td class={cls(x.s.features.shares.gradient_667eea.share)}>{pct(x.s.features.shares.gradient_667eea.share)}</td>
                  <td class={cls(x.s.features.shares.recolored.share)}>{pct(x.s.features.shares.recolored.share)}</td>
                  <td class={cls(x.s.features.shares.script.share)}>{pct(x.s.features.shares.script.share)}</td>
                  <td class={cls(x.s.features.shares.unchanged.share)}>{pct(x.s.features.shares.unchanged.share)}</td>
                  <td class="num">{x.s.features.medianLines ?? '·'}</td>
                  <td class="num">{fmtUsd(x.s.totalCost)}</td>
                </>
              )}
              {g.kind === 'text' && x.d && x.top && (
                <>
                  <td colspan="4" class="ans" title={x.top.value}><Swatches value={x.top.parsed ? x.top.value : null} />{shorten(x.top.value.replace(/\s+/g, ' '), 28)}</td>
                  <td class="num">{pct(x.top.share)}</td>
                  <td class={cls(x.d.bareShare)}>{pct(x.d.bareShare)}</td>
                  <td class={cls(x.d.okShare)}>{pct(x.d.okShare)}</td>
                  <td class="num">{fmtUsd(x.s.totalCost)}</td>
                </>
              )}
              {g.kind === 'sentence' && (
                <>
                  <td colspan="6" class="ans">
                    {x.kept}/{r.n}
                  </td>
                  <td class="num">{x.finalWords ?? '·'}</td>
                  <td class="num">{fmtUsd(x.s.totalCost)}</td>
                </>
              )}
            </tr>
          );
        })}
      </tbody>
    ))}
  </table>
</div>

<style>
  .scroll {
    overflow-x: auto;
  }
  .runs {
    min-width: 46rem;
  }
  .grp th {
    border-bottom: 1px solid var(--ink);
    padding: calc(var(--row) * 5) 0 calc(var(--row) * 1.25);
    color: var(--ink);
    white-space: normal;
  }
  .task {
    font-size: var(--t-xl);
    font-weight: 800;
    font-variation-settings: var(--wide);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-right: 0.8em;
  }
  .prompt {
    font-weight: 400;
    color: var(--ink-2);
    background: none;
    padding: 0;
  }
  .sub th {
    font-size: var(--t-xs);
    border-bottom: 1px solid var(--hair);
    padding-block: 0.5em 0.3em;
  }
  td {
    white-space: nowrap;
  }
  td.zero {
    color: var(--ink-3);
  }
  td.ans {
    font-family: var(--mono);
    font-size: 0.95em;
    padding-left: 1.5em;
  }
  .sub th[colspan] {
    padding-left: 1.5em;
  }
  .note {
    font-size: var(--t-xs);
    color: var(--ink-2);
    white-space: normal;
  }
  tr.held td {
    color: var(--ink-2);
  }
  td.why {
    font-size: var(--t-xs);
    white-space: normal;
    padding-left: 1.5em;
  }
  tbody tr:not(.grp):not(.sub):hover td {
    background: var(--hair-2);
  }
</style>
