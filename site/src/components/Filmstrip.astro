---
/**
 * A chain run, scrubbed. Every step is a real render of one trial; the frame
 * shows the current one large, the strip shows all of them small, and the
 * sparkline tracks how long the file got.
 *
 * Everything for the starting step is rendered here, so with scripts off the
 * page still shows that frame and a strip of thumbnails that link to the
 * trials. src/scripts/filmstrip.ts turns on the controls and does the rest.
 */
import type { Run, Trial } from '../lib/data.ts';
import { MODEL_LABEL, fmtUsd, pad3, thumbPath } from '../lib/data.ts';
import { href } from '../lib/href.mjs';

interface Props {
  run: Run;
  title?: string;
  /** Draw the line-count sparkline under the readout. */
  sparkline?: boolean;
  /** Step shown first, 1-based. */
  startAt?: number;
  /** Placement class from the page grid, e.g. "full" or "wide". */
  class?: string;
}

const { run, title, sparkline = true, startAt = 1, class: cls = '' } = Astro.props;

const FLAGS: [string, (t: Trial) => boolean | null][] = [
  ['glow', (t) => t.glow_or_shadow],
  ['keyframes', (t) => t.keyframes],
  ['script', (t) => t.script],
  ['nondeterministic', (t) => t.nondeterministic],
  ['unchanged', (t) => t.unchanged],
];

const steps = run.trials.map((t) => ({
  step: t.step,
  render: t.renderPath ? href(t.renderPath) : '',
  thumb: t.renderPath ? href(thumbPath(t)!) : '',
  lines: t.lines,
  cost: t.cost_usd === null ? null : fmtUsd(t.cost_usd),
  model: MODEL_LABEL[t.model],
  flags: FLAGS.filter(([, test]) => test(t) === true).map(([name]) => name),
  url: href(`/runs/${t.run}/${pad3(t.step)}/`),
}));

const n = steps.length;
const start = Math.min(Math.max(Math.round(startAt), 1), n) - 1;
const cur = steps[start];

// Sparkline: x is the step, y is lines. The viewBox is in data units and the
// SVG stretches to its box, so the stroke is non-scaling and the marker is HTML.
const lines = steps.map((s) => s.lines ?? 0);
const max = Math.max(...lines, 1);
const points = lines.map((v, i) => `${i},${max - v}`).join(' ');
const xOf = (i: number) => (n > 1 ? (i / (n - 1)) * 100 : 0);
const yOf = (i: number) => ((max - lines[i]) / max) * 100;
---

<div class:list={['film', cls]} data-filmstrip data-start={start + 1} role="group" aria-label={title ?? run.label}>
  <script type="application/json" set:html={JSON.stringify(steps)} />

  <div class="head">
    {title ? <span class="title">{title}</span> : <span></span>}
    <span class="kind">{run.label}</span>
  </div>

  <div class="frame" data-frame role="img" aria-label={`step ${cur.step} render, ${cur.model}, ${cur.lines} lines`}>
    <img class="layer is-front" data-layer="a" src={cur.render || undefined} width="800" height="800" alt="" loading="lazy" decoding="async" />
    <img class="layer" data-layer="b" width="800" height="800" alt="" decoding="async" />
  </div>

  <div class="controls" data-controls hidden>
    <div class="btns">
      <button type="button" class="btn btn-ghost btn-sm" data-prev aria-label="Previous step">prev</button>
      <button type="button" class="btn btn-ghost btn-sm play" data-play>play</button>
      <button type="button" class="btn btn-ghost btn-sm" data-next aria-label="Next step">next</button>
    </div>
    <input type="range" data-range min="1" max={n} step="1" value={start + 1} aria-label="Step" />
  </div>

  <div class="readout">
    <div class="no">
      <span class="lbl">step</span>
      <span class="num"><span data-no>{pad3(cur.step)}</span><span class="of">/ {pad3(steps[n - 1].step)}</span></span>
    </div>

    <dl class="facts">
      <div><dt>model</dt><dd data-model>{cur.model}</dd></div>
      <div><dt>lines</dt><dd data-lines>{cur.lines ?? 'none'}</dd></div>
      <div><dt>cost</dt><dd data-cost>{cur.cost ?? 'none'}</dd></div>
    </dl>

    <div class="tags" aria-label="Features in this step">
      {FLAGS.map(([name]) => (
        <span class="tag" data-flag={name} hidden={!cur.flags.includes(name)}>{name}</span>
      ))}
      <span class="tag none" data-noflags hidden={cur.flags.length > 0}>no flags</span>
    </div>

    {sparkline && (
      <div class="spark" aria-hidden="true">
        <div class="spark-head"><span>lines per step</span><span>max {max}</span></div>
        <div class="plot" data-plot>
          <svg viewBox={`0 0 ${Math.max(n - 1, 1)} ${max}`} preserveAspectRatio="none" focusable="false">
            <polyline points={points} />
          </svg>
          <span class="cursor" data-cursor style={`left:${xOf(start)}%`}></span>
          <span class="dot" data-dot style={`left:${xOf(start)}%;top:${yOf(start)}%`}></span>
        </div>
        <div class="spark-foot"><span>{steps[0].step}</span><span>{steps[n - 1].step}</span></div>
      </div>
    )}

    <a class="open" data-open href={cur.url}>open this trial</a>
  </div>


  <div class="strip" data-strip aria-label={`All ${n} steps`}>
    {steps.map((s, i) => (
      <a
        class="cell"
        data-cell
        data-i={i}
        href={s.url}
        aria-label={`Step ${s.step}${s.lines !== null ? `, ${s.lines} lines` : ''}`}
        aria-current={i === start ? 'step' : undefined}
      >
        {s.thumb ? (
          <img src={s.thumb} width="200" height="200" alt="" loading="lazy" decoding="async" />
        ) : (
          <span class="blank"></span>
        )}
        <span class="n">{pad3(s.step)}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .film {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: calc(var(--row) * 2.5);
    min-width: 0;
    --cell: clamp(56px, 6.2vw, 88px);
  }
  .head,
  .frame,
  .controls,
  .readout,
  .strip {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px var(--gutter);
  }
  .title {
    font-weight: 700;
    font-size: var(--t-lg);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .kind {
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--ink-2);
  }

  /* ---------- stage ---------- */

  .frame {
    align-self: start;
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: 0;
  }
  .layer:global(.is-front) {
    opacity: 1;
  }

  .readout {
    display: flex;
    flex-direction: column;
    gap: calc(var(--row) * 3);
    min-width: 0;
  }
  /* Narrow: frame, controls, readout, strip, so the slider sits under the frame it moves. */
  @media (min-width: 900px) {
    .frame {
      grid-column: 1 / span 5;
      grid-row: 2;
    }
    .readout {
      grid-column: 7 / -1;
      grid-row: 2;
    }
    .controls {
      grid-row: 3;
    }
    .strip {
      grid-row: 4;
    }
  }

  .no {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lbl {
    font-variation-settings: var(--narrow);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1;
  }
  .num {
    display: flex;
    align-items: baseline;
    gap: 0.2em;
    white-space: nowrap;
    font-weight: 800;
    font-variation-settings: var(--wide);
    font-variant-numeric: tabular-nums;
    font-size: var(--t-3xl);
    letter-spacing: -0.05em;
    line-height: 0.85;
  }
  .of {
    font-family: var(--mono);
    font-weight: 500;
    font-variation-settings: normal;
    font-size: 0.26em;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .facts {
    margin: 0;
    border-top: 1px solid var(--ink);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: baseline;
    padding: 6px 0;
    border-bottom: 1px solid var(--hair);
  }
  dt {
    font-variation-settings: var(--narrow);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }
  dd {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 1.9em;
    align-items: flex-start;
    margin-bottom: auto;
  }
  .tag {
    font-family: var(--mono);
    font-size: var(--t-xs);
    line-height: 1.5;
    padding: 1px 7px;
    border: 1px solid var(--ink-3);
  }
  .tag[hidden] {
    display: none;
  }
  .tag[data-flag='unchanged'] {
    background: var(--mark);
    color: var(--mark-ink);
    border-color: var(--ink);
  }
  .tag.none {
    border-color: transparent;
    padding-left: 0;
    color: var(--ink-3);
  }

  /* ---------- sparkline ---------- */

  .spark {
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--ink-2);
    line-height: 1.3;
  }
  .spark-head,
  .spark-foot {
    display: flex;
    justify-content: space-between;
  }
  .plot {
    position: relative;
    height: 84px;
    margin: 8px 5px;
    border-bottom: 1px solid var(--hair);
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5px;
    stroke-linejoin: miter;
    pointer-events: none;
  }
  .plot polyline {
    vector-effect: non-scaling-stroke;
  }
  .cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    margin-left: -0.5px;
    background: var(--ink-3);
    pointer-events: none;
  }
  .dot {
    position: absolute;
    width: 9px;
    height: 9px;
    transform: translate(-50%, -50%);
    background: var(--mark);
    border: 1.5px solid var(--ink);
    pointer-events: none;
  }

  .open {
    font-size: var(--t-sm);
    font-weight: 600;
    align-self: flex-start;
  }

  /* ---------- controls ---------- */

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--row) * 1.5) calc(var(--row) * 2.5);
  }
  .controls[hidden] {
    display: none;
  }
  .btns {
    display: flex;
    gap: 6px;
  }
  .controls input[type='range'] {
    flex: 1 1 220px;
    min-width: 0;
    width: auto;
  }
  .btn:disabled {
    opacity: 0.35;
    cursor: default;
    background: transparent;
    color: var(--ink);
  }
  .play {
    min-width: 5.4em;
    justify-content: center;
  }
  .film[data-playing] .play {
    background: var(--mark);
    color: var(--mark-ink);
  }

  /* ---------- strip ---------- */

  .strip {
    display: flex;
    gap: 1px;
    padding: 1px;
    background: var(--hair);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--ink) var(--paper);
    position: relative;
  }
  .strip:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .cell,
  .cell:hover {
    flex: 0 0 var(--cell);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }
  .cell img,
  .cell .blank {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .n {
    font-family: var(--mono);
    font-size: 0.66rem;
    line-height: 1;
    padding: 4px 4px 5px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .cell:hover .n {
    background: var(--mark);
    color: var(--mark-ink);
  }
  .cell[aria-current='step'] {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .cell[aria-current='step'] .n {
    background: var(--mark);
    color: var(--mark-ink);
  }
</style>

<script>
  import '../scripts/filmstrip.ts';
</script>
